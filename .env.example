# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# WEATHER_API_KEY: Required for weather feature.
WEATHER_API_KEY="YOUR_WEATHER_API_KEY"

# MAYA_API_KEY: Required for secure API authentication if ENFORCE_API_KEY is true.
MAYA_API_KEY="YOUR_SECURE_MAYA_API_KEY"

# ENFORCE_API_KEY: Set to "true" to require MAYA_API_KEY for all API requests.
ENFORCE_API_KEY="false"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
